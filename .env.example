# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL password — change before any deployment
POSTGRES_PASSWORD=changeme_before_deploy

# ── Security (new in v2) ──────────────────────────────────────────────────────

# API key for POST /ingest authentication.
# Leave empty to disable authentication (local dev mode).
# Set to any strong random string for deployed/shared environments.
#   Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection URL — used by the WebSocket broadcaster.
# The default points to the Redis service in docker-compose.yml.
# Only change if you are using an external Redis instance.
REDIS_URL=redis://redis:6379
